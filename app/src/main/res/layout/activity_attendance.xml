<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/background">

    <TextView
        android:id="@+id/tvActionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang xử lý điểm danh..."
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvEvidenceDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đang thu thập vị trí GPS và thông tin Wi-Fi..."
        android:textSize="14sp"
        android:textColor="#616161"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/progressBarAttendance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Về màn hình chính"
        android:visibility="gone"
        android:backgroundTint="@color/primary" />

</LinearLayout>
