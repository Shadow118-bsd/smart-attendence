<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTypeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHECK-IN"
                android:textColor="@color/primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="08:15:30 - 17/09/2026"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_gray" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Verification Status Badges -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFaceBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/success_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="FaceID: Đạt"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvGpsBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/success_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="GPS: Hợp lệ"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvWifiBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@color/success_light"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:text="WiFi: OK"
                        android:textColor="@color/success"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLocationDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tọa độ: 10.7769, 106.7009 | WiFi: Office_WiFi"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFacePhoto"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:background="@color/border_gray"
                android:contentDescription="Ảnh FaceID điểm danh"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/CircularImageView" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
